---
import { withBase } from '../../lib/paths';
interface Props { src: string; original?: string; alt: string; width: number; height: number; caption: string; label: string; class?: string; panorama?: boolean; mobilePanels?: {src: string; width: number; height: number; alt: string; label?: string}[] }
const { src, original = src, alt, width, height, caption, label, class: className = '', panorama = false, mobilePanels = [] } = Astro.props;
---
<figure class:list={['research-figure', className, {'has-mobile-panels': mobilePanels.length > 0, 'figure-panorama': panorama}]}>
  <a class="figure-image figure-complete" href={withBase(original)} target="_blank" rel="noopener" data-figure-zoom data-figure-label={label} aria-label={`Enlarge figure: ${label}`}><img src={withBase(src)} alt={alt} width={width} height={height} loading="lazy" decoding="async" /></a>
  {mobilePanels.length > 0 && <div class="figure-mobile-panels">{mobilePanels.map(panel => <a class="figure-image" href={withBase(panel.src)} target="_blank" rel="noopener" data-figure-zoom data-figure-label={panel.label || label} aria-label={`Enlarge figure panel: ${panel.label || label}`}><img src={withBase(panel.src)} width={panel.width} height={panel.height} alt={panel.alt} loading="lazy" decoding="async" /></a>)}</div>}
  <figcaption><span class="figure-label">{label}</span><span class="figure-caption-text">{caption}</span>{panorama && <span class="figure-pan-hint">Swipe the figure sideways to read it, or open the full figure.</span>}<a class="figure-open" href={withBase(original)} target="_blank" rel="noopener">View full resolution <span aria-hidden="true">↗</span><span class="sr-only"> (new tab)</span></a></figcaption>
</figure>
