---
import '@fontsource-variable/newsreader';
import '@fontsource-variable/newsreader/wght-italic.css';
import '@fontsource-variable/manrope';
import '../styles/tokens.css';
import '../styles/global.css';
import { withBase } from '../lib/paths';
interface Props { title?: string; description?: string; noindex?: boolean; skipTarget?: string }
const { title = 'Yixuan Zhuang — Computer Architecture & Design Automation', description = 'Yixuan Zhuang is an undergraduate at Fudan University working on computer architecture, accelerator evaluation, GPU memory systems, and design automation.', noindex = false, skipTarget = 'main-content' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const social = new URL(withBase('images/social/og.png'), Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0a151f" />
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={social} />
    <meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Yixuan Zhuang — computer architecture and design automation" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
  </head>
  <body><a class="skip-link" href={`#${skipTarget}`}>Skip to content</a><slot /></body>
</html>
